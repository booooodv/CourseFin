# CourseFin 环境变量配置示例
# 复制为 .env 后按需修改（请勿将包含真实密码的 .env 提交到 Git）

# HTTP 监听端口
COURSEFIN_PORT=8096

# 持久化数据目录（SQLite 数据库、封面、缩略图与临时缓存）
COURSEFIN_DATA_DIR=/data

# 日志级别：debug | info | warn | error
COURSEFIN_LOG_LEVEL=info

# 可选：首次启动自动创建的管理员账号（留空则在 Web 页面通过初始化向导创建）
# COURSEFIN_ADMIN_USER=admin
# COURSEFIN_ADMIN_PASS=change-me-to-a-strong-password

# 可选：反代场景下的对外根域名提示（仅支持根路径或独立子域名，不支持子路径）
# COURSEFIN_BASE_URL=https://course.example.com
